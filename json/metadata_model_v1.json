	"properties" : {
		"resource_identifier": {
			"type" : "string",
			"description" : "A unique identifier of the resource being described or cataloged.  dcterms:identifier"		
		},
		"dataservice_endpoint_description": {
			"type" : "string",
			"title" : "DataService Endpoint Description",
			"description" : "A description of the services available via the end-points, including their operations, parameters etc.  URI: dcat:endpointDescription"		
		},
		"dataservice_endpoint_url": {
			"type" : "string",
			"title" : "DataService Endpoint URL",
			"description" : "The root location or primary endpoint of the service (a Web-resolvable IRI).  dcat:endpointURL   https://www.w3.org/TR/vocab-dcat-3/#Property:data_service_endpoint_url  See also https://co-cddo.github.io/ukgov-metadata-exchange-model/endpointURL/ with definition: \"The electronic location where the item (file) being described can be found. Note that there could be a security risk in sharing the endpoint URL for internal services, e.g. hackers can target the endpoint if they become aware of it.\""		
		}
	}
};
