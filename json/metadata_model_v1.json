				},
				"distribution": {
					
					"type" : "array",
					"title" : "Distribution",
					"description" : "A specific representation of a dataset. A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above).  URI: dcat:distribution",
					"items" : [
