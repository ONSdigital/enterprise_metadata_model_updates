									"description" : "A simple alphanumeric code representing the file format of the distribution. Not to be used if the type of the distribution is defined by IANA - if media type is filled out then format isn't needed.  This could potentially be a string.  dcterms:format"									
								},
								"distribution_title": {
									"type" : "string",
									"title" : "Distribution Title",
									"description" : "The full and formal name given to an information resource.  A name given to the distribution.  URI: dct:title  https://co-cddo.github.io/ukgov-metadata-exchange-model/title/ Ex: Distribution-os-postcodes-geopackage-distribution Distribution-os-postcodes-excel-distribution-minimal Distribution-os-postcodes-csv-distribution"									
								},
								"distribution_download_url": {
									"type" : "string",
									"title" : "Distribution Download URL",
									"description" : "The electronic location where the item (file) being described can be found.  The URL of the downloadable file in a given format. E.g., CSV file or RDF file. The format is indicated by the distribution's dcterms:format and/or dcat:mediaType.  URI: dcat:downloadURL  dcat:downloadURL SHOULD be used for the URL at which this distribution is available directly, typically through a HTTP Get request.  https://co-cddo.github.io/ukgov-metadata-exchange-model/downloadURL/"									
								},
								"distribution_byte_size_amount": {
									"type" : "integer",
									"title" : "Distribution Byte Size Amount",
									"description" : "The filesize of the item (file) being described.  The size of the distribution in bytes.  URI: dcat:byteSize  http://co-cddo.github.io/ukgov-metadata-exchange-model/byteSize/"									
