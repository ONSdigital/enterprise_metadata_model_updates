								},
								"distribution_media_type": {
									"type" : "string",
									"title" : "Distribution Media Type",
									"description" : "The media type of the distribution as defined by IANA IANA-MEDIA-TYPES.  URI: dcat:mediaType   Could also be a code list.  See also : https://co-cddo.github.io/ukgov-metadata-exchange-model/mediaType/  https://www.iana.org/assignments/media-types/media-types.xhtml"									
								},
								"distribution_format": {
									"type" : "string",
