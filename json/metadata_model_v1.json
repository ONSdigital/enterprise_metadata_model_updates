			"description" : "A simple alphanumeric code representing the file format of the distribution. Not to be used if the type of the distribution is defined by IANA - if media type is filled out then format isn't needed.  This could potentially be a string.  dcterms:format"		
		},
		"distribution_title": {
			"type" : "string",
			"title" : "Distribution Title",
			"description" : "The full and formal name given to an information resource.  A name given to the distribution.  URI: dct:title  https://co-cddo.github.io/ukgov-metadata-exchange-model/title/ Ex: Distribution-os-postcodes-geopackage-distribution Distribution-os-postcodes-excel-distribution-minimal Distribution-os-postcodes-csv-distribution"		
		},
		"distribution_download_url": {
			"type" : "string",
			"title" : "Distribution Download URL",
			"description" : "The electronic location where the item (file) being described can be found.  The URL of the downloadable file in a given format. E.g., CSV file or RDF file. The format is indicated by the distribution's dcterms:format and/or dcat:mediaType.  URI: dcat:downloadURL  dcat:downloadURL SHOULD be used for the URL at which this distribution is available directly, typically through a HTTP Get request.  https://co-cddo.github.io/ukgov-metadata-exchange-model/downloadURL/"		
		},
		"distribution_byte_size_amount": {
			"type" : "integer",
			"title" : "Distribution Byte Size Amount",
			"description" : "The filesize of the item (file) being described.  The size of the distribution in bytes.  URI: dcat:byteSize  http://co-cddo.github.io/ukgov-metadata-exchange-model/byteSize/"		
		},
		"distribution_replaces_identifier": {
			"type" : "string",
			"title" : "Distribution Replaces Identifier",
			"description" : "The identifier for a related distribution that is supplanted, displaced, or superseded by the described distribution  dcterms:replaces"		
		},
		"distribution_version_notes_description": {
			"type" : "string",
			"title" : "Distribution Version Notes Description",
			"description" : "A description of changes between this version and the previous version of the resource [VOCAB-ADMS]. In the distribution's case this explains the reason for the replacement, if a replacement identifier is present.  adms:versionNotes"		
		},
		"distribution_language": {
			"type" : "string",
			"title" : "Distribution Language Code",
			"description" : "A simple alphanumeric code representing a language of the resource. This refers to the natural language used for textual metadata (i.e., titles, descriptions, etc.) of a cataloged resource (i.e., dataset or service) or the textual values of a dataset distribution.  dcterms:language  Usage note:	If representations of a dataset are available for each language separately, define an instance of dcat:Distribution for each language and describe the specific language of each distribution using dcterms:language (i.e., the dataset will have multiple dcterms:language values and each distribution will have just one as the value of its dcterms:language property). In case of multilingual distributions, the distributions will have multiple dcterms:language values.  (datasets can have multiple languages, however each distribution will have only one)"		
		},
		"distribution_release_date": {
			"type" : "string",
			"title" : "Distribution Release Date",
			"description" : "The date on which an information resource was originally published or otherwise made publicly available for the first time.  dcterms:issued  see also : https://co-cddo.github.io/ukgov-metadata-exchange-model/issued/"		
		},
		"distribution_created_date": {
			"type" : "string",
			"title" : "Distribution Created Date",
			"description" : "The date on which the content of a dataset is created or compiled.  dcterms:created"		
		},
		"distribution_status": {
			"type" : "string",
			"title" : "Distribution Status Code",
			"description" : "A simple alphanumeric code representing the status of the resource in the context of a particular workflow process [VOCAB-ADMS].  I envison this as a lifecycle status code which can be used to indicate the \"currency\" of a distribution.  adms:status  Examples of life-cycle statuses include:  Those defined in the ISO standard for item registration [ISO-19135] (accepted / not accepted, deprecated, experimental, reserved, retired, stable, submitted, superseded, valid / invalid). The progress codes defined in [ISO-19115] (accepted, completed, deprecated, final, historical archive, not accepted, obsolete, ongoing, pending, planned, proposed, required, retired, superseded, tentative, under development, valid, withdrawn). The ADMS Status vocabulary [ADMS-SKOS], used in [DCAT-AP], which includes four statuses: completed, deprecated, under development, and withdrawn. The dataset statuses [EUV-DS] and concept statuses [EUV-CS] vocabularies from the EU Vocabularies registry. The UK Government Linked Data Registry project [UKGOVLD-REG] provides an example of how the life-cycle statuses defined in [ISO-19135] can be used in a registry, along with the criteria for status transition."		
		},
		"distribution_replaced_by_identifier": {
			"type" : "string",
			"title" : "Distribution Replaced By Identifier",
			"description" : "A system-assigned unique identifier for the specific distribution"		
		},
		"distribution_access_rights": {
			"type" : "string",
			"title" : "Distribution Access Rights Code",
			"description" : "A simple alphanumeric code representing the rights statement that concerns how the distribution is accessed.  URI: dct:accessRights  This could be a code that indicates whether the data is openly availalble, limited to internal access, or further limited to permissions groups. I will need support defining this further. - Sam"		
		},
		"distribution_license": {
			"type" : "string",
			"title" : "Distribution Licence Code",
			"description" : "Reference to the legal document outlining access and usage rights for an information resource.  A legal document under which the distribution is made available.  URI: dct:license  https://co-cddo.github.io/ukgov-metadata-exchange-model/licence/  note: This could refer to a code referencing the various licenses or be a URL of the actual document? I think for the start a set of standard codes would be helpful/easiest. DCAT uk guidelines say:  \"Rules as per Open Data Policy, all information and data that is made publicly available by HMG is likely to be released under the Open Government licence unless it is exempt under specific conditions. Any other applicable licences should be explicitly stated.\"  so unless there's a huge variation of licences could have a list..."		
		},
		"distribution_security_classification_code": {
			"type" : "string",
			"title" : "Distribution Security Classification Code",
			"description" : "A simple alphanumeric code representing an information security designation that identifies the minimum level of protection assigned to an information resource.  URI: ukgov_metadata:securityClassification  code list (uk govt security classifications )here: https://www.gov.uk/government/publications/security-policy-framework/hmg-security-policy-framework#information-security"		
		},
		"distribution_access_url": {
			"type" : "string",
			"title" : "Distribution Access URL",
			"description" : "A URL of the resource that gives access to a distribution of the dataset. E.g., landing page, feed, SPARQL endpoint.  dcat:accessURL  dcat:accessURL SHOULD be used for the URL of a service or location that can provide access to this distribution, typically through a Web form, query or API call.  dcat:downloadURL is preferred for direct links to downloadable resources.  If the distribution(s) are accessible only through a landing page (i.e., direct download URLs are not known), then the landing page URL associated with the dcat:Dataset SHOULD be duplicated as access URL on a distribution (see 5.7 Dataset available only behind some Web page)."		
		},
		"resource_identifier": {
			"type" : "string",
			"description" : "A unique identifier of the resource being described or cataloged.  dcterms:identifier"		
		},
		"distribution_access_service_identifier": {
			"type" : "string",
			"title" : "Distribution Access Service Identifier",
			"description" : "A unique identifier of the resource being described or cataloged.  dcterms:identifier"		
		},
		"distribution_modified_date": {
			"type" : "string",
			"title" : "Distribution Modified Date",
			"description" : "Most recent date on which the distribution was changed, updated or modified.  dcterms:modified  This relates to the actual distribution not the catalogue record of the dataset"		
		}
	}
