			"description" : "A system-assigned unique identifier for the agent."		
		},
		"agent_name": {
			"type" : "string",
			"title" : "Agent Name",
			"description" : "The name of the agent.  The name of something is a simple textual string.  foaf:name"		
		},
		"agent_homepage": {
					
			"type" : "array",
			"title" : "Agent Homepage",
			"description" : "A homepage for an agent. The homepage property relates something to a homepage about it.  A 'homepage' in this sense is a public Web document, typically but not necessarily available in HTML format. The page has as a topic the thing whose homepage it is. The homepage is usually controlled, edited or published by the thing whose homepage it is; as such one might look to a homepage for information on its owner from its owner. This works for people, companies, organisations etc.  foaf:homepage  foaf allows multiple homepages. suggesting we capture only the main one, or none at all.",
			"items" : 	[]
		},
		"agent_contact_name": {
			"type" : "string",
			"title" : "Agent Contact Name",
			"description" : "The contact name of the agent - to be used when the agent is an organisation. See also Agent name.  foaf:name"		
		},
		"agent_email": {
			"type" : "string",
			"title" : "Agent Email",
			"description" : "The email address as a mailto URI. Used for communication purposes.  vcard:email"		
		},
		"agent_telephone": {
			"type" : "string",
			"title" : "Agent Telephone",
			"description" : "The landline or mobile phone number for the agent.  vcard:tel"		
		},
		"agent_created_date": {
			"type" : "string",
			"title" : "Agent Created Date",
			"description" : "The calendar date that this agent was created (in the catalogue)  dcterms:created"		
		},
		"agent_modified_date": {
			"type" : "string",
			"title" : "Agent Modified Date",
			"description" : "The calendar date that the agent was last modified in the catalogue.  dcterms:modified"		
		},
		"agent_type": {
			"type" : "string",
			"title" : "Agent Type",
			"description" : "A simple alphanumeric code representing the type of the agent.   This could include things like ONS individual, ONS team, UK Govt, Business... anything really."		
		},
		"attribution": {
			
			"type" : "array",
			"title" : "Attribution",
			"description" : "Attribution is the ascribing of an entity to an agent. When an entity e is attributed to agent ag, entity e was generated by some unspecified activity that in turn was associated to agent ag. Thus, this relation is useful when the activity is not known, or irrelevant.  prov:Attribution",
			"items" : [
				{
					"type" : "object",
					"properties" : {
						"role_identifier": {
							"type" : "string",
							"title" : "Role Code",
							"description" : "A simple alphanumeric code representing ???"							
						},
						"agent_identifier": {
							"type" : "string",
							"title" : "Agent Identifier",
							"description" : "A system-assigned unique identifier for the agent."							
						},
						"resource_identifier": {
							"type" : "string",
							"title" : "Resource Identifier",
							"description" : "A unique identifier of the resource being described or cataloged.  dcterms:identifier"							
						}
					}
				}			]
						}
	}
};
